{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chrome (guest — avoids DWDS autofill crash)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag",
        "--guest"
      ]
    },
    {
      "name": "Windows Desktop",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    }
  ]
}
