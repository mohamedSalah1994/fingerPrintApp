rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function isAdmin() {
      return userDocExists() && userDoc().role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Bootstrap: signed-in user may create their own profile once.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role);
    }

    // Bootstrap center/branch on first setup by any signed-in user.
    match /centers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /branches/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /stages/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /grades/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /classrooms/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /parents/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /groups/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schedules/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /enrollment_subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendances/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /devices/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /biometric_mappings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }
  }
}
